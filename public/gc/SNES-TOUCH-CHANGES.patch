--- a/tools/wasm-toolchain.mjs
+++ b/tools/wasm-toolchain.mjs
@@ -83,6 +83,27 @@ export function loadWasmToolchainLock() {
 
 export function verifyWasmToolchain() {
   const lock = loadWasmToolchainLock();
+  // SNES Touch: the lock pins a Windows toolchain; on macOS take the tools from the environment
+  // (same Emscripten version, a current nightly Rust) without the Windows executable hashes.
+  if (process.platform === "darwin") {
+    const env = (name) => {
+      invariant(process.env[name], `set ${name} to the tool's path`);
+      return process.env[name];
+    };
+    const emcc = env("EMCC");
+    return {
+      lock: { ...lock, rust: { ...lock.rust, toolchain: "nightly" } },
+      paths: {
+        node: process.execPath, emcc, emcmake: env("EMCMAKE"), cmake: env("CMAKE"), ninja: env("NINJA"),
+        rustc: env("RUSTC"), cargo: env("CARGO"), rustup: env("RUSTUP"),
+        clangxx: resolve(dirname(emcc), "../bin/clang++")
+      },
+      hashes: {
+        lock: sha256File(lockPath),
+        cargoLock: sha256NormalizedTextFile(resolve(root, "tools/naga-spirv-wgsl/Cargo.lock"))
+      }
+    };
+  }
   invariant(lock.schemaVersion === 1, `Unsupported toolchain lock schema ${lock.schemaVersion}`);
   invariant(`${process.platform}-${process.arch}` === lock.platform, `Toolchain lock requires ${lock.platform}`);
 
