+bool WebGPUCommandStream::WaitForReadback(const std::atomic<u32>& fence, u32 serial) const
+{
+  // Generous: the first use of a pipeline can wait for the browser to compile its shaders, and
+  // the discio worker may be busy with a long task before it replays the readback. A copy whose
+  // wait gives up reaches RAM with whatever the buffer held before (Zelda: Ocarina of Time
+  // Master Quest then built its pause screen from the previous depth copy).
+  constexpr double kTimeoutMs = 5000.0;
+  // Core::PauseAndLock (save states, pausing) runs on the discio worker and waits for this
+  // thread to go idle, so a readback it still owes then can't land until the wait gives up.
+  constexpr double kSteppingTimeoutMs = 20.0;
+  const double start = emscripten_get_now();
+  for (;;)
+  {
+    const u32 done = fence.load(std::memory_order_acquire);
+    if (done == serial)
+      return true;
+    const double waited = emscripten_get_now() - start;
+    if (waited >= kTimeoutMs || ConsumerFailed() ||
+        (waited >= kSteppingTimeoutMs && Core::System::GetInstance().GetCPU().IsStepping()))
+    {
+      return false;
+    }
+    emscripten_futex_wait(
+        const_cast<volatile void*>(reinterpret_cast<const volatile void*>(&fence)), done, 4.0);
+  }
+}
